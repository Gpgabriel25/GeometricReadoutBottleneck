\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The geometric readout bottleneck pipeline. Probes decode counts at $R^2{\approx }1.0$, but the count-encoding direction is orthogonal to \texttt  {lm\_head} digit rows ($|\cos |{\leq }0.032$). Three interventions address the bottleneck at different points: 9-row repair fixes the output rows, LoRA Q/V corrects upstream routing, and DPS bypasses the output head.}}{2}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{2}{The geometric readout bottleneck pipeline. Probes decode counts at $R^2{\approx }1.0$, but the count-encoding direction is orthogonal to \texttt {lm\_head} digit rows ($|\cos |{\leq }0.032$). Three interventions address the bottleneck at different points: 9-row repair fixes the output rows, LoRA Q/V corrects upstream routing, and DPS bypasses the output head}{figure.caption.3}{}}
